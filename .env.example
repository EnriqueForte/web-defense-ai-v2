# LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=groq/openai/gpt-oss-120b
LLM_RATE_LIMIT_RETRIES=2
LLM_RATE_LIMIT_BACKOFF_SECONDS=10
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=45
LLM_FALLBACK_MODELS=groq/openai/gpt-oss-20b
LLM_TEMPERATURE=0.1

# Rutas
LOG_PATH=./logs/access.log
REPORT_PATH=./reports/
# `legacy-docker` conserva el origen anterior; `dvwa-lab` usa el Compose aislado de fase 6.
LOG_SYNC_SOURCE=legacy-docker

# Pipeline
INTERVALO_MINUTOS=2
ANALYSIS_DB_PATH=.local-state/analysis.sqlite3
# Solo laboratorio local; requiere ejecutor activo y reiniciar Flask tras cambiarla.
ANALYSIS_MANUAL_ENABLED=0
# Preparación de fase 7; mantener apagado hasta aceptar el piloto de fase 6.
NEXT_PRIMARY_ENABLED=0
MAX_LINEAS_LOG=100
UMBRAL_FUERZA_BRUTA=5

# Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opcional: lista separada por comas. Por defecto intenta ambos destinos configurados.
NOTIFICATION_DESTINATIONS=telegram,email

# Email (opcional)
EMAIL_REMITENTE=
EMAIL_PASSWORD=
EMAIL_DESTINATARIO=
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
# STARTTLS se mantiene activado; usar 0 solo con el sink SMTP local Mailpit.
EMAIL_SMTP_STARTTLS=1

# CrewAI
CREWAI_TRACING_ENABLED=false
