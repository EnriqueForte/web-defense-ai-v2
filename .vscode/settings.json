{
    "editor.formatOnSave": false,
    "files.autoSave": "off",
    "files.encoding": "utf8",
    "window.title": "${dirty}${activeEditorShort}${separator}web-defense-ai V2${separator}${appName}",
    "editor.rulers": [
        88
    ],
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "yaml.schemas": {
        "https://raw.githubusercontent.com/compose-spec/compose-spec/master/schema/compose-spec.json": "docker-compose.yml"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/node_modules": true,
        "**/.next": true,
        "**/logs": true,
        "**/reports": true,
        "**/.env": true,
        "**/.env.*": true
    },
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/node_modules/**": true,
        "**/.next/**": true
    },
    "editor.fontSize": 14,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "css.validate": false,
    "html.validate.styles": false
}
