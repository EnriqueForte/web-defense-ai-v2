{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "web-defense-ai V2: verificar regresión aislada",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-B", "scripts/check_baseline.py"],
            "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONIOENCODING": "utf-8" } },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "web-defense-ai V2: verificar sintaxis Python",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-B", "scripts/check_syntax.py"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "web-defense-ai V2: dashboard con recarga local",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-B", "-m", "flask", "--app", "dashboard.app", "--debug",
                "run", "--host", "127.0.0.1", "--port", "5000", "--no-debugger"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PYTHONIOENCODING": "utf-8" }
            },
            "runOptions": { "instanceLimit": 1 },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "web-defense-ai V2: interfaz Next.js de demostración",
            "type": "process",
            "command": "node",
            "args": ["node_modules/next/dist/bin/next", "dev", "--hostname", "127.0.0.1"],
            "options": { "cwd": "${workspaceFolder}/frontend" },
            "runOptions": { "instanceLimit": 1 },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "web-defense-ai V2: verificar frontend",
            "type": "process",
            "command": "node",
            "args": ["node_modules/eslint/bin/eslint.js", "src/app"],
            "options": { "cwd": "${workspaceFolder}/frontend" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "web-defense-ai V2: comprobar tipos frontend",
            "type": "process",
            "command": "node",
            "args": ["node_modules/typescript/bin/tsc", "--noEmit"],
            "options": { "cwd": "${workspaceFolder}/frontend" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "web-defense-ai V2: compilar frontend",
            "type": "process",
            "command": "node",
            "args": ["node_modules/next/dist/bin/next", "build"],
            "options": { "cwd": "${workspaceFolder}/frontend" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        }
    ]
}
