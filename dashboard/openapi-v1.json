{
  "openapi": "3.0.3",
  "info": {
    "title": "web-defense-ai V2 Local API",
    "version": "1.0.0",
    "description": "API local de lectura, configuración LLM por instalación y solicitud manual opcional a un ejecutor separado. La configuración LLM solo se escribe desde localhost y se guarda en el .env local; nunca devuelve claves. La solicitud manual conserva el control ANALYSIS_MANUAL_ENABLED=1; el dashboard solo habilita esa acción si hay una clave configurada. Las fechas de eventos ausentes se representan como null."
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/estado": {
      "get": {
        "operationId": "getEstado",
        "summary": "Estado compuesto desde una captura de archivos",
        "responses": {
          "200": { "description": "Estado disponible o degradado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EstadoResponse" } } } },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/salud": {
      "get": {
        "operationId": "getSalud",
        "summary": "Salud de las fuentes locales observadas",
        "responses": { "200": { "description": "Salud del servicio y estado de archivos", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/fuentes/log": {
      "get": {
        "operationId": "getFuenteLog",
        "summary": "Leer estado local de la captura sin contactar Docker ni ejecutar análisis",
        "responses": { "200": { "description": "Estado de fuente y última captura, incluidos ausencia, error y antigüedad", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/fuentes/log/capturar": {
      "post": {
        "operationId": "capturarFuenteLog",
        "summary": "Captura manual opcional de Puerto Umbral, sin modelo ni notificaciones",
        "description": "Requiere perfil Puerto Umbral, LOG_CAPTURE_MANUAL_ENABLED=1, origen local autorizado y ejecutor detenido. Conserva generaciones anteriores y usa el modo elegido en el perfil.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "maxProperties": 0 } } } },
        "responses": {
          "200": { "description": "Snapshot publicado con hash y procedencia; analysis_requested=false", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/fuentes/log/seguimiento": {
      "get": {
        "operationId": "getSeguimientoLog",
        "summary": "Leer sesión y checkpoint locales sin capturar, contactar Docker o iniciar trabajo",
        "responses": { "200": { "description": "Estado, propiedad, duración, último ciclo, checkpoint y contadores; sin reanudación automática", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/fuentes/log/seguimiento/{action}": {
      "post": {
        "operationId": "controlarSeguimientoLog",
        "summary": "Iniciar, pausar, reanudar o detener una sesión acotada sin análisis",
        "description": "Requiere perfil Puerto Umbral, LOG_FOLLOW_ENABLED=1 y origen local autorizado. Iniciar admite únicamente interval_seconds (5–60, predeterminado 5) y duration_seconds (60–1800, predeterminado 1800); las otras acciones requieren {}. El inicio rechaza ejecutor, trabajo pendiente o bloqueos incompatibles. Pausar conserva los bloqueos de ciclo y motor; detener los libera al terminar. Pausing/stopping significa confirmación aún pendiente. El cierre de pestaña no detiene la sesión. No se crean trabajos, análisis o notificaciones.",
        "parameters": [{ "name": "action", "in": "path", "required": true, "schema": { "type": "string", "enum": ["iniciar", "pausar", "reanudar", "detener"] } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "interval_seconds": { "type": "integer", "minimum": 5, "maximum": 60, "default": 5 },
            "duration_seconds": { "type": "integer", "minimum": 60, "maximum": 1800, "default": 1800 }
          }
        } } } },
        "responses": {
          "200": { "description": "Estado de fuente con following: stopped/following/pausing/paused/stopping/completed/error/interrupted, owned_here, session_active, checkpoint y últimos ciclos; analysis_requested y notifications_requested son false", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/configuracion/llm": {
      "get": {
        "operationId": "getConfiguracionLLM",
        "summary": "Leer proveedor, modelo y estado de credenciales sin revelar claves",
        "responses": {
          "200": { "description": "Configuración local segura para mostrar en el dashboard", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LLMSettingsResponse" } } } },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "put": {
        "operationId": "putConfiguracionLLM",
        "summary": "Guardar proveedor, modelo y clave para esta instalación local",
        "description": "Requiere una solicitud JSON desde un origen localhost autorizado. El cambio se escribe atómicamente en .env y se rechaza mientras haya un análisis activo. Una clave vacía conserva la clave ya guardada.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LLMSettingsInput" } } } },
        "responses": {
          "200": { "description": "Configuración guardada; ninguna clave se devuelve", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LLMSettingsResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/amenazas": {
      "get": {
        "operationId": "getAmenazas",
        "parameters": [
          { "name": "tipo", "in": "query", "schema": { "type": "string" } },
          { "name": "severidad", "in": "query", "schema": { "type": "string", "enum": ["CRITICA", "ALTA", "MEDIA", "BAJA", "DESCONOCIDA"] } },
          { "name": "ip", "in": "query", "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" }
        ],
        "responses": {
          "200": { "description": "Amenazas del reporte actual", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AmenazasResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/reportes": {
      "get": {
        "operationId": "getReportes",
        "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }],
        "responses": {
          "200": { "description": "Reportes actuales e históricos paginados", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReportesResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/analisis/actual": {
      "get": {
        "operationId": "getAnalisisActual",
        "summary": "Último trabajo y disponibilidad del ejecutor",
        "responses": { "200": { "description": "Estado persistente o vacío", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/analisis/{job_id}": {
      "get": {
        "operationId": "getAnalisis",
        "parameters": [{ "name": "job_id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-f0-9]{32}$" } }],
        "responses": {
          "200": { "description": "Estado y tiempos del trabajo", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobResponse" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/analisis": {
      "post": {
        "operationId": "postAnalisis",
        "summary": "Solicitar análisis manual local e idempotente",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "maxLength": 80 } }],
        "responses": {
          "202": { "description": "Trabajo aceptado o solicitud repetida", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "description": "Hay otro trabajo activo", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobResponse" } } } },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/reportes/{report_id}": {
      "get": {
        "operationId": "getReporte",
        "parameters": [{ "name": "report_id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }],
        "responses": {
          "200": { "description": "Markdown original y metadatos; display_markdown opcional ofrece una vista derivada con intervalos sin modificar el archivo", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "type": "object", "required": ["report", "markdown"], "properties": { "report": { "type": "object" }, "markdown": { "type": "string" }, "display_markdown": { "type": "string" } } } } } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "PerPage": { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } }
    },
    "responses": {
      "Error": { "description": "Error sin trazas ni secretos", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "LLMSettingsInput": {
        "type": "object", "additionalProperties": false,
        "required": ["provider", "model", "pricing_mode"],
        "properties": {
          "provider": { "type": "string", "enum": ["groq", "openrouter"] },
          "model": { "type": "string", "maxLength": 256 },
          "pricing_mode": { "type": "string", "enum": ["free", "paid"] },
          "api_key": { "type": "string", "maxLength": 4096, "description": "Clave nueva; vacío u omitido conserva la existente." }
        }
      },
      "LLMProviderStatus": {
        "type": "object", "required": ["id", "label", "default_model", "free_models", "api_key_configured"],
        "properties": {
          "id": { "type": "string", "enum": ["groq", "openrouter"] },
          "label": { "type": "string" }, "default_model": { "type": "string" },
          "free_models": { "type": "array", "items": { "type": "string" } },
          "api_key_configured": { "type": "boolean" }
        }
      },
      "LLMSettingsResponse": {
        "type": "object", "required": ["meta", "data"], "properties": {
          "meta": { "type": "object", "properties": { "api_version": { "type": "string" } } },
          "data": { "type": "object", "required": ["provider", "model", "pricing_mode", "api_key_configured", "providers"], "properties": {
            "provider": { "type": "string", "enum": ["groq", "openrouter"] },
            "model": { "type": "string" }, "pricing_mode": { "type": "string", "enum": ["free", "paid"] },
            "api_key_configured": { "type": "boolean" },
            "providers": { "type": "array", "items": { "$ref": "#/components/schemas/LLMProviderStatus" } }
          } }
        }
      },
      "JobResponse": {
        "type": "object", "required": ["meta", "data"], "properties": {
          "meta": { "type": "object" },
          "data": { "type": "object", "required": ["id", "kind", "status", "phase", "requested_at", "executor"], "properties": {
            "id": { "type": "string" }, "kind": { "type": "string", "enum": ["manual", "periodic"] },
            "status": { "type": "string", "enum": ["queued", "running", "succeeded", "failed", "interrupted"] },
            "phase": { "type": "string" }, "requested_at": { "type": "string", "format": "date-time" },
            "started_at": { "type": "string", "format": "date-time", "nullable": true },
            "finished_at": { "type": "string", "format": "date-time", "nullable": true },
            "last_ingested_at": { "type": "string", "format": "date-time", "nullable": true },
            "last_analyzed_at": { "type": "string", "format": "date-time", "nullable": true },
            "report_id": { "type": "string", "nullable": true }, "error_code": { "type": "string", "nullable": true },
            "executor": { "type": "string", "enum": ["online", "offline", "unavailable"] }
          } }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "object", "required": ["code", "message", "request_id"], "properties": {
            "code": { "type": "string" }, "message": { "type": "string" }, "request_id": { "type": "string" }
          } }
        }
      },
      "Meta": {
        "type": "object",
        "required": ["api_version", "snapshot_id", "captured_at", "health", "sources"],
        "properties": {
          "api_version": { "type": "string", "example": "1" },
          "schema": { "type": "string" },
          "snapshot_id": { "type": "string", "nullable": true },
          "captured_at": { "type": "string", "format": "date-time" },
          "consistency": { "type": "string" },
          "health": { "type": "string", "enum": ["ok", "degraded", "unavailable"] },
          "sources": { "type": "object" },
          "report_id": { "type": "string", "nullable": true }
        }
      },
      "Threat": {
        "type": "object",
        "required": ["id", "number", "severity", "type", "status", "source_ip", "event_time", "source_report_id"],
        "properties": {
          "id": { "type": "string" }, "number": { "type": "string" },
          "severity": { "type": "string" }, "type": { "type": "string" },
          "status": { "type": "string" }, "source_ip": { "type": "string" },
          "event_time": { "type": "string", "format": "date-time", "nullable": true },
          "event_time_start": { "type": "string", "format": "date-time", "nullable": true, "description": "Primera hora observada en las evidencias del grupo estructurado" },
          "event_time_end": { "type": "string", "format": "date-time", "nullable": true, "description": "Última hora observada; no implica actividad continua entre extremos" },
          "event_time_missing_count": { "type": "integer", "minimum": 0 },
          "source_report_id": { "type": "string", "nullable": true }
        }
      },
      "EstadoResponse": {
        "type": "object", "required": ["meta", "data"], "properties": {
          "meta": { "$ref": "#/components/schemas/Meta" },
          "data": { "type": "object", "required": ["stats", "threats", "threats_total", "threats_truncated", "recent_log", "recent_events", "source_ips", "timeline", "recent_reports"], "properties": {
            "stats": { "type": "object" }, "threats": { "type": "array", "items": { "$ref": "#/components/schemas/Threat" } },
            "threats_total": { "type": "integer" }, "threats_truncated": { "type": "boolean" },
            "recent_events": { "type": "array", "items": { "type": "object", "required": ["id", "observed_at", "category", "source_ip", "method", "path", "http_status"], "properties": { "id": { "type": "string" }, "observed_at": { "type": "string", "format": "date-time" }, "category": { "type": "string" }, "source_ip": { "type": "string", "nullable": true }, "method": { "type": "string" }, "path": { "type": "string" }, "http_status": { "type": "integer" } } } },
              "recent_log": { "type": "array", "items": { "type": "string" } },
              "log_period": { "type": "object", "description": "Fechas de peticiones presentes en la copia del log; distintas de su fecha de modificación", "properties": {
                "first_at": { "type": "string", "format": "date-time", "nullable": true },
                "last_at": { "type": "string", "format": "date-time", "nullable": true },
                "undated_lines": { "type": "integer", "minimum": 0 }
              } },
            "source_ips": { "type": "array", "items": { "type": "string" } },
            "timeline": { "type": "object" }, "recent_reports": { "type": "array", "items": { "type": "object" } }
          } }
        }
      },
      "AmenazasResponse": { "type": "object", "required": ["meta", "data"], "properties": {
        "meta": { "type": "object", "properties": { "api_version": { "type": "string" }, "snapshot_id": { "type": "string" }, "report_id": { "type": "string", "nullable": true }, "scope": { "type": "string" }, "total": { "type": "integer" }, "page": { "type": "integer" }, "per_page": { "type": "integer" } } },
        "data": { "type": "array", "items": { "$ref": "#/components/schemas/Threat" } }
      } },
      "ReportesResponse": { "type": "object", "required": ["meta", "data"], "properties": {
        "meta": { "type": "object", "properties": { "api_version": { "type": "string" }, "total": { "type": "integer" }, "page": { "type": "integer" }, "per_page": { "type": "integer" } } },
        "data": { "type": "array", "items": { "type": "object", "required": ["id", "filename", "modified_at", "size_bytes", "current"] } }
      } }
    }
  }
}
